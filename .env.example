# Copy to .env and fill in. Never commit .env.

# --- MongoDB (use your Atlas URI in production) ---
MONGODB_URI=mongodb://mongo:27017/universalfit
MONGODB_DATABASE=universalfit

# --- JWT (generate with: openssl rand -base64 48) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# --- Recommendation engine ---
ENGINE_BASE_URL=http://engine:8000
ENGINE_API_KEY=change-me-shared-secret

# --- Web / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Redis (optional cache) ---
REDIS_URL=redis://redis:6379

# --- Seed data (DEMO / UNVERIFIED brands and charts) ---
SEED_DEMO_DATA=true
